# EasyEnglish Environment Variables
# Copy this file to .env or set these in your Vercel Project Settings

# ==========================================
# 1. RevenueCat Configuration
# ==========================================
# RevenueCat Public SDK API Key (begins with test_ or goog_ for Google Play)
REVENUECAT_PUBLIC_KEY=test_GgvQOwcslbINPAtgGoOOehUJdhe

# RevenueCat Secret API Key (found in RevenueCat Dashboard -> Project -> API Keys -> Secret)
# Used by Vercel serverless function to verify user entitlements
REVENUECAT_SECRET_KEY=rc_secret_your_secret_key_here

# Entitlement ID configured in RevenueCat dashboard
REVENUECAT_ENTITLEMENT_ID=easy_english_pro

# Product identifiers in RevenueCat
REVENUECAT_PRODUCT_YEARLY=yearly
REVENUECAT_PRODUCT_MONTHLY=monthly

# ==========================================
# 2. Google Gemini AI Configuration
# ==========================================
# Google AI Studio Gemini API Key (https://aistudio.google.com/app/apikey)
# Powers the 24/7 AI Speaking Coach (Gemini 2.5 Flash Lite)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ==========================================
# 3. Upstash Redis (Daily Quota Rate Limiter)
# ==========================================
# Create a free Redis DB at https://upstash.com (Free tier: 10,000 commands/day)
# Protects your Gemini API key by strictly enforcing 50 AI queries/day per paying user
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ==========================================
# 4. App Client Configuration
# ==========================================
# Base URL for the AI Coach Vercel Proxy endpoint
AI_COACH_ENDPOINT=https://your-vercel-domain.vercel.app/api/coach
